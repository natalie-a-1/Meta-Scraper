# Local simulation; no credentials and no real charges.
PAYMENT_MODE=demo
PORT=4242
PUBLIC_BASE_URL=http://localhost:4242
DATABASE_PATH=./data/lucci-pay.sqlite

# Native payment-sheet testing also requires OpenAI beta access.
# PAYMENT_MODE=test
# CHATGPT_CHECKOUT_ENABLED=true

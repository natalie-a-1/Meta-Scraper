{
  "name": "lucci-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Payment requests and native checkout for ChatGPT",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build:widget && node --import tsx --env-file-if-exists=.env server/index.ts",
    "build:widget": "node scripts/build-widget.mjs",
    "build": "npm run typecheck && npm run build:widget && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "demo:request": "node --import tsx --env-file-if-exists=.env examples/request-payment.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "jose": "^6.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.27.0",
    "prettier": "3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
